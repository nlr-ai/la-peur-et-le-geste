    },
    {
      "de": "cole-turner",
      "date": {
        "annee": 2001,
        "lune": 10,
        "jour": 10
      },
      "texte": "Je suis déjà au Manoir, Phoebe. J'en déduis — sans même facturer la consultation — que ce message était destiné à Paige. Renvoie-le-lui.",
      "ref": "vmuslqcm23sn4"
    },
    {
      "de": "phoebe-halliwell",
